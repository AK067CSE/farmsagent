# Streamlit Farm Advisor - Environment Variables Template
# Copy this file to .env and fill in your actual API keys

# Google API Key (required for Gemini AI)
GOOGLE_API_KEY=your_google_api_key_here

# Weather providers
# - auto: try OpenWeatherMap if key is set, else fallback to Open-Meteo
# - openweather: force OpenWeatherMap
# - openmeteo: force Open-Meteo
WEATHER_PROVIDER=auto

# OpenWeatherMap API Key (optional - uses Open-Meteo as fallback if not set)
OPENWEATHER_API_KEY=your_openweather_api_key_here
